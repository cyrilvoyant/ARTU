@prefix schema: <https://schema.org/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix cv: <https://github.com/cyrilvoyant/ARTU#> .

cv:software a schema:SoftwareSourceCode ;
 schema:name "ARTU coefficient lookup archive" ;
 schema:codeRepository <https://github.com/cyrilvoyant/ARTU> ;
 schema:programmingLanguage "MATLAB" ;
 schema:citation <https://doi.org/10.1016/j.renene.2022.04.065> ;
 schema:identifier <https://doi.org/10.5281/zenodo.21755931> ;
 schema:description "K_alpha.m corrected on 2026-10-23 (undefined R); matches the paper example. Documentation, not an executable adapter." ;
 cv:input cv:corrh, cv:corr2h, cv:Q ;
 cv:intendedOutput cv:K, cv:alpha .
cv:corrh a schema:PropertyValue ; schema:name "Lag-h autocorrelation" ; schema:unitCode unit:UNITLESS .
cv:corr2h a schema:PropertyValue ; schema:name "Lag-2h autocorrelation" ; schema:unitCode unit:UNITLESS .
cv:Q a schema:PropertyValue ; schema:name "Reliability table selector" ; schema:description "Discrete selector 0,1,2,3 for R = 0, 0.01, 0.05, 0.1 (R = noise variance over signal variance); default 2." ; schema:unitCode unit:UNITLESS .
cv:K a schema:PropertyValue ; schema:name "Intended K coefficient" ; schema:unitCode unit:UNITLESS .
cv:alpha a schema:PropertyValue ; schema:name "Intended alpha coefficient" ; schema:unitCode unit:UNITLESS .
